# Copy to .env.local (git-ignored). setup.sh generates a local one with a random DB password.
DATABASE_URL=postgres://qbank:change-me@127.0.0.1:5432/qbank
TEST_DATABASE_URL=postgres://qbank:change-me@127.0.0.1:5432/qbank_test
E2E_DATABASE_URL=postgres://qbank:change-me@127.0.0.1:5432/qbank_e2e
# Optional (defaults shown)
QBANK_API_HOST=127.0.0.1
QBANK_API_PORT=3000
QBANK_COOKIE_SECURE=true
QBANK_TRUST_PROXY=false
QBANK_ALLOWED_ORIGINS=
QBANK_SESSION_TTL_DAYS=30
QBANK_LOG_LEVEL=info

export function probeDuplicateB(rows: string[]): string[] {
  const cleaned: string[] = [];
  for (const row of rows) {
    const value = row.trim();
    if (value.length === 0) {
      continue;
    }
    if (value.startsWith("#")) {
      continue;
    }
    cleaned.push(value.toLowerCase());
  }
  cleaned.sort();
  return cleaned;
}

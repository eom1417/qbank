{
  "name": "qbank-engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env.local --import tsx --watch src/server/main.ts",
    "dev:web": "vite",
    "migrate": "node --env-file-if-exists=.env.local --import tsx src/server/migrate.ts",
    "build": "tsc -p tsconfig.json --outDir dist && vite build",
    "start": "node --env-file-if-exists=.env.local dist/src/server/main.js",
    "test": "vitest run",
    "bench:extraction": "node --import tsx src/server/tools/extraction-bench/main.ts",
    "qbank": "node scripts/qbank.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "secretlint": "13.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.7",
    "@fastify/static": "10.1.8",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  }
}

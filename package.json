{
  "name": "qbank-engine",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env.local --import tsx --watch src/server/main.ts",
    "dev:web": "vite",
    "migrate": "node --env-file-if-exists=.env.local --import tsx src/server/migrate.ts",
    "build": "tsc -p tsconfig.json --outDir dist && vite build",
    "start": "node --env-file-if-exists=.env.local dist/src/server/main.js",
    "test": "vitest run",
    "bench:extraction": "node --import tsx src/server/tools/extraction-bench/main.ts",
    "bench:truth": "node --import tsx src/server/tools/extraction-bench/truth-main.ts",
    "bench:truth-samples": "node --import tsx src/server/tools/extraction-bench/truth-samples.ts",
    "bench:review-sample": "node --import tsx src/server/tools/extraction-bench/review-sample.ts",
    "bench:manifest": "node --import tsx src/server/tools/extraction-bench/manifest.ts",
    "bench:vision-prepare": "node --import tsx src/server/tools/vision-cost/prepare.ts",
    "bench:vision": "node --import tsx src/server/tools/vision-cost/run.ts",
    "bench:units": "node --import tsx src/server/tools/extraction-bench/units-report.ts",
    "bench:pipeline": "node --import tsx src/server/tools/extraction-bench/pipeline-bench.ts",
    "bench:detection": "node --import tsx src/server/tools/detection-bench/main.ts",
    "bench:evidence": "node --import tsx src/server/tools/extraction-bench/evidence-bench.ts",
    "bench:answers": "node --env-file-if-exists=.env.local --import tsx src/server/tools/answer-bench/main.ts",
    "qbank": "node scripts/qbank.mjs",
    "bench:perf": "vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "prettier": "3.10.1",
    "secretlint": "14.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.10",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  }
}

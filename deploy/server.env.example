# Copy to .env next to compose.server.yaml and fill the lines below (docs/SELF-HOST.md).
# The address your friends open, pointing at this server (ports 80 and 443 open to it).
QBANK_DOMAIN=qbank.example.com
# A long random password for the database; make one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# You, the server's operator (DEC-40): the account that signs up with this e-mail gets the
# "Server administration" screen (feedback, password-reset requests, the import queue), and
# never sees anyone's banks or questions. Sign up with it yourself right after the first start.
QBANK_OPERATOR_EMAIL=you@example.com
# The name every user sees as running this server, e.g. your first name. Delete the line rather
# than leave it empty: an empty value stops QBank from starting.
QBANK_OPERATOR_NAME=Your name
# Imports that run at the same time, never two for one account. 2 suits a 4 GB server.
QBANK_IMPORT_WORKERS=2
# AI sessions running at once across the server. 6 suits an 8 GB server; lower it on a smaller one.
QBANK_AI_HOSTS_MAX=6
# Optional: Google sign-in (docs/SELF-HOST.md). Fill both or delete both lines; with both set,
# everyone signs in with Google only.
# QBANK_GOOGLE_CLIENT_ID=
# QBANK_GOOGLE_CLIENT_SECRET=
# Optional: an https address from an uptime service, pinged every few minutes; the service
# alerts you when the pings stop (the server is down).
# QBANK_HEARTBEAT_URL=https://hc-ping.com/your-check-id
# Optional: a folder on this machine (a mounted disk or a synced folder) that also gets each
# daily backup; the newest 7 are kept there. Backups always go to the qbank-backups volume.
# QBANK_BACKUP_COPY_TO=/mnt/backup-disk/qbank
